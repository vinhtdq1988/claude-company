{
  "name": "claude-company",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Company – công ty AI ảo vận hành thật",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @claude-company/api --filter @claude-company/worker --filter @claude-company/web dev",
    "lint": "eslint . && prettier --check .",
    "db:migrate": "pnpm --filter @claude-company/db db:migrate",
    "db:seed": "pnpm --filter @claude-company/db db:seed",
    "test:unit": "vitest run --project unit",
    "test:local": "node scripts/test-local.mjs",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@claude-company/api": "workspace:*",
    "@claude-company/contracts": "workspace:*",
    "@claude-company/db": "workspace:*",
    "@claude-company/model-gateway": "workspace:*",
    "@claude-company/policy": "workspace:*",
    "@claude-company/worker": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/testing": "^11.2.9",
    "@opentelemetry/api": "^1.10.0",
    "@playwright/test": "^1.65.0",
    "@swc/core": "^1.16.22",
    "@testcontainers/minio": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
