# Sao chép thành docker/.env rồi điền giá trị thật. File docker/.env KHÔNG được commit.
# Mọi giá trị dưới đây chỉ là giá trị mẫu, không phải secret thật.

# --- Model ---
# anthropic: gọi Claude thật. fake: FakeModelProvider tất định, không tốn token.
MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=

# --- Bảo mật phiên ---
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# --- Thực thi hành động ---
# v1.0 chỉ có adapter dry_run; live chưa cấu hình sẽ trả ADAPTER_LIVE_NOT_CONFIGURED.
ADAPTER_MODE=dry_run
# Thư mục gốc trên máy chủ chứa workspace của AI Employee (mount_path phải nằm trong đây).
WORKSPACE_HOST_PATH=./data/workspaces

# --- Ngân sách và giới hạn (R13) ---
BUDGET_WARN_THRESHOLD=0.8
DEFAULT_MONTHLY_COST_LIMIT_USD=20
DEFAULT_MONTHLY_TOKEN_LIMIT=2000000
SDK_BUDGET_HEADROOM=0.1
SDK_RUN_RESERVE_USD=2
SDK_RUN_RESERVE_TOKENS=200000
SDK_RESUME_AFTER_CRASH=false
ARTIFACT_CONTEXT_MAX_BYTES=200000

# --- Vòng đời task và run ---
MAX_REWORK=3
RUN_TIMEOUT_MS=900000
RETRY_MAX=3

# --- Sandbox và mạng ra ngoài (service do T111, T111a thêm) ---
EGRESS_PROXY_URL=http://egress-proxy:3128
SANDBOX_RUNNER_URL=http://sandbox-runner:4000
SANDBOX_RUNNER_TOKEN=thay-bang-token-ngau-nhien

# --- PostgreSQL ---
# Role owner dùng cho migration; role app_user (không BYPASSRLS) dùng cho ứng dụng.
POSTGRES_DB=claude_company
POSTGRES_USER=cc_owner
POSTGRES_PASSWORD=thay-mat-khau-owner
APP_DB_PASSWORD=thay-mat-khau-app-user
DATABASE_URL=postgres://app_user:thay-mat-khau-app-user@postgres:5432/claude_company
DATABASE_MIGRATION_URL=postgres://cc_owner:thay-mat-khau-owner@postgres:5432/claude_company

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Lưu trữ S3 (MinIO khi chạy local) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=claude-company-artifacts
S3_ACCESS_KEY=cc_minio
S3_SECRET_KEY=thay-mat-khau-minio
S3_FORCE_PATH_STYLE=true

# Heartbeat và phục hồi run (R5)
RUN_HEARTBEAT_INTERVAL_MS=5000
RUN_STALE_AFTER_MS=60000
SWEEP_INTERVAL_MS=30000

RUN_WORKTREES_PATH=/worktrees
WORKER_CONSUME_JOBS=true
