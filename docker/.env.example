# Sao chép thành docker/.env rồi điền giá trị thật. File docker/.env KHÔNG được commit.
# Mọi giá trị dưới đây chỉ là giá trị mẫu, không phải secret thật.

# --- Model ---
# anthropic: gọi Claude thật bằng ANTHROPIC_API_KEY (dùng cho production).
# claude_subscription: chỉ chạy local, dùng đăng nhập `claude login` của Claude Code CLI, không cần key;
#   bị từ chối khi NODE_ENV=production và không chạy được trong Docker (container không có đăng nhập).
# fake: FakeModelProvider tất định, không tốn token.
MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=

# --- Bảo mật phiên ---
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# --- Thực thi hành động ---
# v1.0 chỉ có adapter dry_run; live chưa cấu hình sẽ trả ADAPTER_LIVE_NOT_CONFIGURED.
ADAPTER_MODE=dry_run
# Nhắc người duyệt: lần đầu sau 1 giờ, sau đó mỗi 24 giờ (không bao giờ tự duyệt).
# Run chờ duyệt đã có quyết định mà không tiến triển sau chừng này thì sweeper phát lại job (Nguyên tắc VII).
APPROVAL_REPLAY_AFTER_MS=120000
APPROVAL_REMINDER_FIRST_MS=3600000
APPROVAL_REMINDER_REPEAT_MS=86400000
# Thư mục gốc trên máy chủ chứa workspace của AI Employee (mount_path phải nằm trong đây).
WORKSPACE_HOST_PATH=./data/workspaces

# --- Ngân sách và giới hạn (R13) ---
BUDGET_WARN_THRESHOLD=0.8
DEFAULT_MONTHLY_COST_LIMIT_USD=20
DEFAULT_MONTHLY_TOKEN_LIMIT=2000000
SDK_BUDGET_HEADROOM=0.1
SDK_RUN_RESERVE_USD=2
SDK_RUN_RESERVE_TOKENS=200000
SDK_RESUME_AFTER_CRASH=false
ARTIFACT_CONTEXT_MAX_BYTES=200000

# --- CEO AI Assistant (R14) ---
ASSISTANT_DEFAULT_DEADLINE_HOURS=72
ASSISTANT_MAX_OPS_PER_RUN=30

# --- Vòng đời task và run ---
MAX_REWORK=3
RUN_TIMEOUT_MS=900000
RETRY_MAX=3

# --- Bảo mật HTTP ---
# Số lần đăng nhập tối đa cho mỗi cặp (IP, email) trong một cửa sổ (mỗi IP được gấp 5 lần).
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Sandbox và mạng ra ngoài ---
# docker-compose.yml tự đặt EGRESS_PROXY_URL, HTTPS_PROXY, NO_PROXY và SANDBOX_RUNNER_URL cho worker.
# Token chung giữa worker và sandbox-runner (>= 16 ký tự, ngẫu nhiên).
SANDBOX_RUNNER_TOKEN=thay-bang-token-ngau-nhien-dai-hon-16-ky-tu
# Host duy nhất egress-proxy cho phép worker kết nối (CONNECT 443), ngăn cách bằng dấu phẩy.
EGRESS_ALLOWLIST=api.anthropic.com

# --- PostgreSQL ---
# Role owner dùng cho migration; role app_user (không BYPASSRLS) dùng cho ứng dụng.
POSTGRES_DB=claude_company
POSTGRES_USER=cc_owner
POSTGRES_PASSWORD=thay-mat-khau-owner
APP_DB_PASSWORD=thay-mat-khau-app-user
DATABASE_URL=postgres://app_user:thay-mat-khau-app-user@postgres:5432/claude_company
DATABASE_MIGRATION_URL=postgres://cc_owner:thay-mat-khau-owner@postgres:5432/claude_company

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Lưu trữ S3 (MinIO khi chạy local) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=claude-company-artifacts
S3_ACCESS_KEY=cc_minio
S3_SECRET_KEY=thay-mat-khau-minio
S3_FORCE_PATH_STYLE=true

# Heartbeat và phục hồi run (R5)
RUN_HEARTBEAT_INTERVAL_MS=5000
RUN_STALE_AFTER_MS=60000
SWEEP_INTERVAL_MS=30000

RUN_WORKTREES_PATH=/worktrees
WORKER_CONSUME_JOBS=true
